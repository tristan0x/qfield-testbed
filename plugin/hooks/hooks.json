{
  "description": "Point the agent at the qfield-testbed skill in QFieldCloud, QFieldSync, QField and QGIS plugin checkouts",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session_context.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
