# Generated by qfield-testbed for deployment "{{ name }}" — do not edit, re-rendered on every start.
# Layered over QFieldCloud's docker-compose.yml + docker-compose.override.standalone.yml of revision {{ revision }}.
services:
  app:
    image: {{ images["app"] }}
    ports:
      - "127.0.0.1:{{ ports.app }}:8000"
{% if worktree %}
    # live reload of the Django app from the worktree
    command: python3 manage.py runserver 0.0.0.0:8000
    volumes:
      - {{ checkout }}/docker-app/qfieldcloud:/usr/src/app/qfieldcloud
{% endif %}

  worker_wrapper:
    image: {{ images["worker_wrapper"] }}
{% if worktree %}
    volumes:
      - {{ checkout }}/docker-app/qfieldcloud:/usr/src/app/qfieldcloud
      - {{ checkout }}/docker-app/worker_wrapper:/usr/src/app/worker_wrapper
{% endif %}
{% for service in qgis_services %}

  {{ service }}:
    image: {{ images[service] }}
{% endfor %}
{% if "createbuckets" in images %}

  createbuckets:
    image: {{ images["createbuckets"] }}
{% endif %}
{% for service in tls_services %}

  {{ service }}:
    profiles: ["tls"]
{% endfor %}
{% if "mirror_transformation_grids" in services %}

  # mirrors the whole cdn.proj.org; opt in with `--profile grids`
  mirror_transformation_grids:
    profiles: ["grids"]
{% endif %}

networks:
  default:
    name: {{ network }}
