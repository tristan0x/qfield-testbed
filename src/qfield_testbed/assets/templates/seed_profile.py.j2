"""Generated by qfield-testbed: seed the QGIS profile of deployment "{{ name }}" (idempotent).

Runs headless with the interpreter QGIS was built against. Settings land in `profiles/default/QGIS/{{ qgis_app_name }}.ini`,
the authentication configuration in `profiles/default/qgis-auth.db`, both under QGIS_CUSTOM_CONFIG_PATH.
"""

import json
import os
import sys
from pathlib import Path

PROFILES_PATH = Path({{ profiles_path | tojson }})
MASTER_PASSWORD_FILE = Path({{ master_password_file | tojson }})
SETTINGS = json.loads({{ settings_json | tojson }})
AUTH = json.loads({{ auth_json | tojson }})

os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
os.environ["QGIS_CUSTOM_CONFIG_PATH"] = str(PROFILES_PATH)
os.environ["QGIS_AUTH_PASSWORD_FILE"] = str(MASTER_PASSWORD_FILE)

from qgis.core import QgsApplication, QgsAuthMethodConfig, QgsSettings  # noqa: E402

# the desktop application names its settings file QGIS/QGIS3.ini (QGIS 3) or QGIS/QGIS4.ini (QGIS 4);
# a bare script would otherwise write "Unknown Organization.ini"
QgsApplication.setOrganizationName("QGIS")
QgsApplication.setOrganizationDomain("qgis.org")
QgsApplication.setApplicationName({{ qgis_app_name | tojson }})

app = QgsApplication([], False)
app.initQgis()
report = {"settings_dir": QgsApplication.qgisSettingsDirPath()}

settings = QgsSettings()
for key, value in SETTINGS.items():
    settings.setValue(key, value)

if AUTH:
    manager = QgsApplication.authManager()
    if manager.isDisabled():
        print("error: the QGIS authentication system is disabled", file=sys.stderr)
        sys.exit(2)
    if not manager.masterPasswordIsSet():
        master_password = MASTER_PASSWORD_FILE.read_text().splitlines()[0]
        if not manager.setMasterPassword(master_password, True):
            print("error: cannot set the master password of the authentication database", file=sys.stderr)
            sys.exit(2)
    existing = [c for c in manager.availableAuthMethodConfigs().values() if c.name() == AUTH["name"]]
    if existing:
        config = QgsAuthMethodConfig()
        manager.loadAuthenticationConfig(existing[0].id(), config, True)
    else:
        config = QgsAuthMethodConfig()
        config.setMethod(AUTH["method"])
        config.setName(AUTH["name"])
    config.setUri(AUTH["uri"])
    for key, value in AUTH["config"].items():
        config.setConfig(key, value)
    if existing:
        ok = manager.updateAuthenticationConfig(config)
    else:
        ok, _ = manager.storeAuthenticationConfig(config)
    if not ok:
        print("error: cannot store the authentication configuration", file=sys.stderr)
        sys.exit(2)
    for key in AUTH.get("id_settings", []):
        settings.setValue(key, config.id())
    report["authcfg"] = config.id()

settings.sync()
app.exitQgis()
print(json.dumps(report))
