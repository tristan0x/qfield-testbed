# Generated by qfield-testbed for deployment "{{ name }}" — the testbed's own services next to QFieldCloud's.
services:
{% if android %}
  android:
    image: {{ android.image }}
    devices:
      - /dev/kvm
    environment:
      EMULATOR_DEVICE: {{ android.device | tojson }}
      EMULATOR_DATA_PARTITION: "2048m"
      WEB_VNC: "true"
    ports:
      - "127.0.0.1:{{ ports.novnc }}:6080"
      - "127.0.0.1:{{ ports.adb }}:5555"
    shm_size: 2gb
    stop_grace_period: 30s

  # inside the emulator, 10.0.2.2 is the container running it; socat turns its :8000 into QFieldCloud's app:8000
  qfc-proxy:
    image: alpine/socat
    network_mode: "service:android"
    command: TCP-LISTEN:8000,fork,reuseaddr TCP:app:8000
    depends_on:
      - android
{% endif %}

networks:
  default:
    name: {{ network }}
    external: true
